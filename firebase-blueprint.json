{
  "entities": {
    "Bus": {
      "title": "Bus",
      "description": "Information about buses and their assigned drivers.",
      "type": "object",
      "properties": {
        "busNumber": { "type": "string", "description": "The unique number of the bus." },
        "driverName": { "type": "string", "description": "The name of the driver assigned to the bus." }
      },
      "required": ["busNumber", "driverName"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Records of bus movements and payments.",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "integer" },
        "approvalNumber": { "type": "string" },
        "delegateNumber": { "type": "string" },
        "organization": { "type": "string" },
        "busesQuantity": { "type": "string" },
        "ticketsCount": { "type": "string" },
        "busNumber": { "type": "string", "description": "Primary bus number (legacy or first in list)" },
        "driverName": { "type": "string", "description": "Primary driver name (legacy or first in list)" },
        "buses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "busNumber": { "type": "string" },
              "driverName": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "hijriDate": { "type": "string" },
        "customDate": { "type": "string" },
        "dateKey": { "type": "string" },
        "eventTime": { "type": "string" },
        "directionFrom": { "type": "string" },
        "directionTo": { "type": "string" },
        "notes": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverMobile": { "type": "string" },
        "receiverId": { "type": "string" },
        "deviceName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "issuedByName": { "type": "string", "maxLength": 40, "description": "Frozen snapshot of issuer display name on the receipt at issuance time." },
        "issuedByUid": { "type": "string", "description": "UID of the user who issued the voucher." },
        "overrideReason": { "type": "string", "maxLength": 500, "description": "General manager override reason when assigning a recently active bus." },
        "duplicateOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "busNumber": { "type": "string" },
              "previousVoucherNumber": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        }
      },
      "required": ["voucherNumber", "timestamp", "dateKey", "userName"]
    },
    "Counter": {
      "title": "Counter",
      "description": "Atomic sequential counters.",
      "type": "object",
      "properties": {
        "last": { "type": "integer", "description": "Last allocated sequential number." }
      },
      "required": ["last"]
    },
    "BusAssignment": {
      "title": "BusAssignment",
      "description": "Tracks the active voucher assignment per bus to prevent duplicate delivery.",
      "type": "object",
      "properties": {
        "voucherId": { "type": "string", "maxLength": 128 },
        "voucherNumber": { "type": "integer" },
        "officeNo": { "type": "string", "maxLength": 40 },
        "officeName": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "released"] },
        "releasedAt": { "type": ["string", "null"], "format": "date-time" },
        "releaseReason": { "type": ["string", "null"], "enum": ["archived", "cancelled", "edited", null] }
      },
      "required": ["voucherId", "voucherNumber", "officeNo", "officeName", "createdAt", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "App-wide settings.",
      "type": "object",
      "properties": {
        "nextVoucherNumber": { "type": "integer" },
        "logoUrl": { "type": "string", "maxLength": 900000 },
        "sloganUrl": { "type": "string", "maxLength": 900000 },
        "sloganHeightMm": { "type": "number" },
        "welcomeTitle": { "type": "string", "maxLength": 120 },
        "welcomeMessage": { "type": "string", "maxLength": 300 },
        "welcomeEnabled": { "type": "boolean" },
        "welcomeExpiresAt": { "type": "string", "maxLength": 20 },
        "welcomeVersion": { "type": "integer" },
        "printCopies": { "type": "integer" },
        "printCopyLabels": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "pdfMargins": { "type": "object" },
        "activeSeason": { "type": "string", "maxLength": 20 },
        "activeSeasonName": { "type": "string", "maxLength": 100 },
        "hijriOffsetDays": { "type": "integer" },
        "companyAddress": { "type": "string", "maxLength": 200 },
        "companyWebsite": { "type": "string", "maxLength": 120 },
        "companyPhone": { "type": "string", "maxLength": 40 },
        "idleTimeoutMinutes": { "type": "integer" },
        "lastArchivedSeason": { "type": "string", "maxLength": 20 },
        "lastSeasonArchivedAt": { "type": "string", "maxLength": 60 },
        "lastBackupAt": { "type": "string", "maxLength": 60 },
        "lastBackupByName": { "type": "string", "maxLength": 120 },
        "lastBackupByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 60 },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable administrative audit trail for settings, counter overrides, and backups.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 80 },
        "targetPath": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 500 },
        "changes": { "type": "array" },
        "reason": { "type": "string", "maxLength": 500 },
        "metadata": { "type": "object" },
        "performedByUid": { "type": "string", "maxLength": 128 },
        "performedByName": { "type": "string", "maxLength": 120 },
        "performedByRole": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "targetPath", "summary", "performedByUid", "performedByName", "performedByRole", "createdAt"]
    },
    "AppUser": {
      "title": "App User",
      "description": "Custom credentials and profile metadata for app access.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "displayName": { "type": "string" },
        "receiptName": { "type": "string", "maxLength": 40, "description": "Arabic display name printed on vouchers issued by this user." },
        "role": { "type": "string", "enum": ["general_manager", "supervisor", "data_entry", "pending", "rejected", "admin", "user"] },
        "authUid": { "type": "string", "description": "The anonymous UID assigned by Firebase." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "password", "displayName", "role"]
    },
    "ActiveSession": {
      "title": "Active Session",
      "description": "Maps an anonymous Firebase Auth UID to a username in app_users for security rule verification.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "uid", "updatedAt"]
    }
  },
  "firestore": {
    "buses/{busNumber}": {
      "schema": "Bus",
      "description": "Master list of buses."
    },
    "vouchers/{voucherId}": {
      "schema": "Voucher",
      "description": "Historical archive of transactions."
    },
    "counters/{counterId}": {
      "schema": "Counter",
      "description": "Atomic sequential counters such as counters/vouchers."
    },
    "busAssignments/{busNumber}": {
      "schema": "BusAssignment",
      "description": "Latest active voucher assignment per bus."
    },
    "settings/{docId}": {
      "schema": "Settings",
      "description": "Global application settings and migration summary."
    },
    "auditLog/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable admin audit log."
    },
    "app_users/{username}": {
      "schema": "AppUser",
      "description": "Custom user credentials."
    },
    "active_sessions/{sessionId}": {
      "schema": "ActiveSession",
      "description": "Active Firebase UID to custom app_users username mapping."
    }
  }
}
